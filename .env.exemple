# Gimaweb — configuration serveur (copier en .env, jamais committé)
# Hash SHA-256 du mot de passe admin (écrire le mot de passe en clair puis hacher hors ligne) :
#   echo -n "ton-mot-de-passe" | sha256sum
ADMIN_HASH_SHA256=
# Port d'écoute en LAN (décision figée : 3000)
PORT=3000
# Emplacement de la base (défaut : data/gimaweb.db à la racine du dépôt)
# DB_PATH=/var/lib/gimaweb/gimaweb.db
# Secret server-to-server du plugin WP ADW MEC API (POST /api/bookings/upsert) — requis pour la sync des réservations
# BOOKINGS_SECRET=
# Sauvegarde nocturne chiffrée (AES-256-GCM) — refus de sauvegarder sans phrase de passe
# BACKUP_PASSPHRASE=
# BACKUP_DIR=/var/lib/gimaweb/sauvegardes
# Export WebDAV Nextcloud (silencieusement désactivé si vide)
# NEXTCLOUD_WEBDAV_URL=https://cloud.example.org/remote.php/dav/files/gimaweb
# NEXTCLOUD_USER=
# NEXTCLOUD_PASS=
